{
  "name": "gtk-base",
  "version": "0.0.1",
  "description": "GTK Base",
  "author": "Igor Bobko <limit-speed@yandex.ru>",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:e2e": "vue-cli-service test:e2e",
    "lint": "vue-cli-service lint",
    "start": "vue-cli-service serve --open",
    "postinstall": "node scripts/sync-jquery.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "core-js": "^3.51.0",
    "datatables.net-dt": "^1.13.11",
    "vue-datatables-net": "^1.2.5",
    "global": "^4.4.0",
    "mdbvue": "^6.5.1",
    "vee-validate": "^3.4.15",
    "vue": "2.7.16",
    "vue-router": "^3.6.5",
    "vue2-datepicker": "^3.11.1",
    "vuex": "^3.1.2",
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~5.0.9",
    "@vue/cli-plugin-e2e-cypress": "~5.0.9",
    "@vue/cli-plugin-eslint": "~5.0.9",
    "@vue/cli-service": "~5.0.9",
    "babel-eslint": "^10.0.3",
    "del-cli": "^8.0.1",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^9.33.0",
    "register-service-worker": "^1.6.2",
    "sass-loader": "^17.0.1",
    "vue-cli-plugin-mdb": "~2.1.0",
    "vue-template-compiler": "2.7.16",
    "sass": "^1.80.0",
    "cypress": "^8.7.0",
    "@babel/core": "^7.29.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {
      "vue/multi-word-component-names": [
        "error",
        {
          "ignores": [
            "home2",
            "customers",
            "Dashboard",
            "Maps",
            "Profile",
            "Tables"
          ]
        }
      ]
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "resolutions": {
    "serialize-javascript": "7.1.4"
  }
}
